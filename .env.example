VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Spotify — hidden unless VITE_ENABLE_SPOTIFY=true (the Spotify API caps
# non-extended apps to allowlisted dev users). Client ID can also be pasted
# into Settings → Spotify.
# Not a secret: the desktop app uses Authorization Code + PKCE, no client secret.
# Register http://127.0.0.1:14565/callback as the redirect URI in the Spotify dashboard.
VITE_ENABLE_SPOTIFY=
VITE_SPOTIFY_CLIENT_ID=
